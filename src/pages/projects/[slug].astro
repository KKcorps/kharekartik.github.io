---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import { formatMonthYear } from '../../lib/content';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
	const projects = await getCollection('projects', ({ data }) => !data.draft);

	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const withBase = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\//, '')}`;
---

<SiteLayout title={project.data.title} description={project.data.summary} hideChrome bodyClass="article-page">
	<div class="shell">
		<nav class="article-nav">
			<a href={withBase('/')} class="logo">kartik khare<span class="cursor-block"></span></a>
			<div class="article-nav__actions">
				<a href={withBase('/about/')} class="nav-link">ABOUT</a>
				<ThemeToggle />
			</div>
		</nav>

		<div class="article-gap" aria-hidden="true"></div>
		<hr />

		<div class="breadcrumb">
			<span class="user">kartik</span>@site:<a href={withBase('/projects/')}>~/projects</a>/<span class="active">{project.id}</span> $
		</div>

		<header class="article-header">
			<h1 class="article-title">{project.data.title}</h1>
			<div class="article-meta">
				<span>By <a href={withBase(SITE.author.path)} rel="author">{SITE.author.name}</a></span>
				<span class="sep">/</span>
				<span>{project.data.status}</span>
				{
					project.data.startedOn && (
						<>
							<span class="sep">/</span>
							<span>Started {formatMonthYear(project.data.startedOn)}</span>
						</>
					)
				}
				{project.data.stack.map((item) => (
					<>
						<span class="sep">/</span>
						<span>{item}</span>
					</>
				))}
				{
					project.data.demo && (
						<>
							<span class="sep">/</span>
							<a href={project.data.demo}>Live demo</a>
						</>
					)
				}
				{
					project.data.repo && (
						<>
							<span class="sep">/</span>
							<a href={project.data.repo}>Repository</a>
						</>
					)
				}
			</div>
		</header>

		<hr />

		<article class="article-body">
			<div class="prose">
				<Content />
			</div>
		</article>

		<footer class="article-footer">
			<nav class="footer-links">
				<a href={withBase('/projects/')}>ALL PROJECTS</a>
				<a href="https://medium.com/@kharekartik" target="_blank" rel="noreferrer">MEDIUM</a>
				<a href="https://github.com/kharekartik" target="_blank" rel="noreferrer">GITHUB</a>
				<a href="mailto:kharekartik@gmail.com">EMAIL</a>
			</nav>
		</footer>
	</div>
</SiteLayout>
