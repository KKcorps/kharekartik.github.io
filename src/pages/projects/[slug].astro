---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import AccentCycle from '../../components/AccentCycle.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import { formatMonthYear } from '../../lib/content';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
	const projects = await getCollection('projects', ({ data }) => !data.draft);

	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const withBase = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\//, '')}`;
const demoUrl = project.data.demo ? new URL(project.data.demo) : undefined;
// A demo hosted on this site is embedded by path so it also loads in dev.
const demoSrc = demoUrl && (demoUrl.origin === SITE.origin ? withBase(demoUrl.pathname) : demoUrl.href);
const demoHost = demoUrl && `${demoUrl.host}${demoUrl.pathname}`.replace(/\/$/, '');
---

<SiteLayout
	title={project.data.title}
	description={project.data.summary}
	hideChrome
	bodyClass="article-page project-page"
>
	<AccentCycle />
	<div class="shell">
		<nav class="article-nav">
			<a href={withBase('/')} class="logo">kartik khare<span class="cursor-block"></span></a>
			<div class="article-nav__actions">
				<a href={withBase('/projects/')} class="nav-link">PROJECTS</a>
				<a href={withBase('/about/')} class="nav-link">ABOUT</a>
				<ThemeToggle />
			</div>
		</nav>

		<div class="article-gap" aria-hidden="true"></div>
		<hr />

		<div class="breadcrumb">
			<span class="user">kartik</span>@site:<a href={withBase('/projects/')}>~/projects</a>/<span class="active">{project.id}</span> $
		</div>

		<header class="article-header">
			<h1 class="article-title">{project.data.title}</h1>
			<div class="article-meta">
				<span>{project.data.status}</span>
				{
					project.data.startedOn && (
						<>
							<span class="sep">/</span>
							<span>Started {formatMonthYear(project.data.startedOn)}</span>
						</>
					)
				}
				{project.data.stack.map((item) => (
					<>
						<span class="sep">/</span>
						<span>{item}</span>
					</>
				))}
				{
					project.data.repo && (
						<>
							<span class="sep">/</span>
							<a href={project.data.repo}>Repository</a>
						</>
					)
				}
			</div>
		</header>

		<article class="article-body">
			<div class="prose">
				<Content />
			</div>
		</article>

		{
			demoSrc && (
				<section class="project-demo" aria-label={`${project.data.title} demo`}>
					<div class="project-demo__bar">
						<span class="project-demo__dot" aria-hidden="true" />
						<span class="project-demo__host">{demoHost}</span>
						<div class="project-demo__actions">
							<button type="button" data-demo-fullscreen hidden>[ fullscreen ]</button>
							<a href={demoSrc} target="_blank" rel="noreferrer">[ new tab ]</a>
						</div>
					</div>
					<div class="project-demo__stage" data-demo-stage>
						<iframe
							src={demoSrc}
							title={`${project.data.title} demo`}
							allow="fullscreen; autoplay; gamepad"
						/>
					</div>
				</section>
			)
		}

		<footer class="article-footer">
			<nav class="footer-links">
				<a href={withBase('/projects/')}>ALL PROJECTS</a>
				<a href="https://medium.com/@kharekartik" target="_blank" rel="noreferrer">MEDIUM</a>
				<a href="https://github.com/kharekartik" target="_blank" rel="noreferrer">GITHUB</a>
				<a href="mailto:kharekartik@gmail.com">EMAIL</a>
			</nav>
		</footer>
	</div>

	<script is:inline>
		(() => {
			const button = document.querySelector('[data-demo-fullscreen]');
			const stage = document.querySelector('[data-demo-stage]');

			if (!(button instanceof HTMLButtonElement) || !(stage instanceof HTMLElement) || !document.fullscreenEnabled) {
				return;
			}

			button.hidden = false;
			button.addEventListener('click', () => {
				void stage.requestFullscreen();
			});
		})();
	</script>
</SiteLayout>
