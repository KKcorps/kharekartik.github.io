---
import AccentCycle from '../../components/AccentCycle.astro';
import ProjectPreview from '../../components/ProjectPreview.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
const withBase = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\//, '')}`;
---

<SiteLayout
	title="Projects"
	description="Side projects by Kartik Khare that you can play in the browser. Mostly games and simulators built to avoid a simpler fix."
	hideChrome
	bodyClass="article-page project-page"
>
	<AccentCycle />
	<div class="shell">
		<nav class="article-nav">
			<a href={withBase('/')} class="logo">kartik khare<span class="cursor-block"></span></a>
			<div class="article-nav__actions">
				<a href={withBase('/projects/')} class="nav-link is-active" aria-current="page">PROJECTS</a>
				<a href={withBase('/about/')} class="nav-link">ABOUT</a>
				<ThemeToggle />
			</div>
		</nav>

		<div class="article-gap" aria-hidden="true"></div>
		<hr />

		<div class="breadcrumb">
			<span class="user">kartik</span>@site:<span class="active">~/projects</span> $ <span class="cmd">ls</span>
		</div>

		<header class="article-header">
			<h1 class="article-title">Projects</h1>
			<p class="project-lede">
				Things I built instead of doing the sensible thing. Every one of them runs in the browser.
			</p>
		</header>

		<hr />

		<section class="project-list" aria-label="Projects">
			{projects.map((project) => <ProjectPreview project={project} />)}
		</section>

		<footer class="article-footer">
			<nav class="footer-links">
				<a href="https://medium.com/@kharekartik" target="_blank" rel="noreferrer">MEDIUM</a>
				<a href="https://github.com/kharekartik" target="_blank" rel="noreferrer">GITHUB</a>
				<a href="mailto:kharekartik@gmail.com">EMAIL</a>
			</nav>
		</footer>
	</div>
</SiteLayout>
