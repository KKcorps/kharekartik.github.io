---
import type { CollectionEntry } from 'astro:content';
import { formatMonthYear } from '../lib/content';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const stackPreview = project.data.stack.slice(0, 3).join(' / ');
const withBase = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\//, '')}`;
---

<a class="project-row" href={withBase(`/projects/${project.id}/`)}>
	<p class="project-row__date">{formatMonthYear(project.data.startedOn)}</p>
	<div class="project-row__body">
		<h2 class="project-row__title">{project.data.title}</h2>
		<p class="project-row__summary">{project.data.summary}</p>
		{stackPreview && <p class="project-row__stack">{stackPreview}</p>}
	</div>
	<span class="project-row__cta">{project.data.demo ? '[ play ]' : '[ read ]'}</span>
</a>
