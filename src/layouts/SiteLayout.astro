---
import ThemeToggle from '../components/ThemeToggle.astro';
import { SITE, absoluteUrl } from '../lib/site';
import '../styles/global.css';

type StructuredData = Record<string, unknown>;

interface Props {
	title?: string;
	description?: string;
	canonicalPath?: string;
	socialImage?: string;
	pageType?: 'website' | 'article' | 'profile';
	publishedOn?: Date;
	updatedOn?: Date;
	noindex?: boolean;
	structuredData?: StructuredData | StructuredData[];
	hideChrome?: boolean;
	bodyClass?: string;
}

const {
	title,
	description = SITE.defaultDescription,
	canonicalPath,
	socialImage = SITE.defaultSocialImage,
	pageType = 'website',
	publishedOn,
	updatedOn,
	noindex = false,
	structuredData,
	hideChrome = false,
	bodyClass = '',
} = Astro.props;
const pageTitle = title
	? title.includes(SITE.name)
		? title
		: `${title} | ${SITE.name}`
	: SITE.defaultTitle;
const pathname = Astro.url.pathname;
const siteOrigin = Astro.site?.href ?? SITE.origin;
const canonicalUrl = absoluteUrl(canonicalPath ?? pathname, siteOrigin);
const socialImageUrl = absoluteUrl(socialImage, siteOrigin);
const rssUrl = absoluteUrl('/rss.xml', siteOrigin);
const sitemapUrl = absoluteUrl('/sitemap-index.xml', siteOrigin);
const jsonLdItems = structuredData
	? Array.isArray(structuredData)
		? structuredData
		: [structuredData]
	: [];
const serializeJsonLd = (value: StructuredData) =>
	JSON.stringify(value).replace(/</g, '\\u003c');
const withBase = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\//, '')}`;

const navItems = [
	{ href: '/', label: 'Home', match: pathname === '/' },
	{ href: '/about/', label: 'About', match: pathname.startsWith('/about/') },
	{ href: '/writing/', label: 'Writing', match: pathname.startsWith('/writing/') },
	{ href: '/projects/', label: 'Projects', match: pathname.startsWith('/projects/') },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex,follow" />}
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" type="application/rss+xml" title={`${SITE.name} writing feed`} href={rssUrl} />
		<link rel="sitemap" href={sitemapUrl} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:type" content={pageType} />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${SITE.name} — engineering notes`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl} />
		{pageType === 'article' && publishedOn && (
			<meta property="article:published_time" content={publishedOn.toISOString()} />
		)}
		{pageType === 'article' && updatedOn && (
			<meta property="article:modified_time" content={updatedOn.toISOString()} />
		)}
		<link rel="icon" type="image/svg+xml" sizes="any" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<link rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
		<title>{pageTitle}</title>
		{jsonLdItems.map((item) => <script is:inline type="application/ld+json" set:html={serializeJsonLd(item)} />)}
		<script is:inline>
			(() => {
				const storageKey = 'theme-preference';
				const accentPaletteKey = 'home-accent-palette';
				const root = document.documentElement;
				const storedTheme = localStorage.getItem(storageKey);
				const preferredTheme = storedTheme || 'dark';
				const parseHexToRgb = (hex) => {
					const normalized = hex.replace('#', '').trim();
					if (!/^[0-9a-fA-F]{6}$/.test(normalized)) {
						return null;
					}

					const red = Number.parseInt(normalized.slice(0, 2), 16);
					const green = Number.parseInt(normalized.slice(2, 4), 16);
					const blue = Number.parseInt(normalized.slice(4, 6), 16);

					return `${red} ${green} ${blue}`;
				};

				root.dataset.theme = preferredTheme;
				root.style.colorScheme = preferredTheme;

				const storedPalette = localStorage.getItem(accentPaletteKey);
				if (!storedPalette) {
					return;
				}

				try {
					const palette = JSON.parse(storedPalette);
					const accent = preferredTheme === 'light' ? palette?.light : palette?.dark;
					if (!accent?.hex || !accent?.dim) {
						return;
					}

					root.style.setProperty('--accent', accent.hex);
					root.style.setProperty('--accent-dim', accent.dim);
					const accentRgb = parseHexToRgb(accent.hex);
					if (accentRgb) {
						root.style.setProperty('--accent-rgb', accentRgb);
					}
				} catch {
					// ignore malformed localStorage values
				}
			})();
		</script>
	</head>
	<body class={bodyClass}>
		{
			!hideChrome && (
				<>
					<div class="site-backdrop" aria-hidden="true">
						<div class="site-backdrop__glow"></div>
						<div class="site-backdrop__scanline"></div>
					</div>

					<header class="site-header">
						<a class="site-header__brand" href={import.meta.env.BASE_URL}>
							<span class="site-header__brand-title">{SITE.name}</span>
							<span class="site-header__brand-note">build notes / project logs</span>
						</a>

						<nav class="site-nav" aria-label="Primary">
							{
								navItems.map((item) => (
									<a class={item.match ? 'is-active' : undefined} href={withBase(item.href)}>
										{item.label}
									</a>
								))
							}
						</nav>

						<ThemeToggle />
					</header>
				</>
			)
		}

		<main class="site-main">
			<slot />
		</main>

		{
			!hideChrome && (
				<footer class="site-footer">
					<p class="site-footer__brand">KK // BUILD NOTES</p>
					<div class="site-footer__status">
						<span class="site-footer__dot" aria-hidden="true"></span>
						<span>ACTIVE // {year}</span>
					</div>
				</footer>
			)
		}
	</body>
</html>
